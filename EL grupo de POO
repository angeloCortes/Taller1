				op = Integer.parseInt(scanner.nextLine());
			} catch (NumberFormatException e) {
				System.out.println("Error: debe ingresar una opción valida\n");
				return;
			}
			File carpeta = new File("Reportes");
			
			/*El método exists() es una función de File que sirve para comprobar si un archivo existe en la ruta especificada.*/
			if (!carpeta.exists()) {
				/*es un comando que se utiliza para crear una nueva carpeta o directorio en el sistema de archivos.*/
			    boolean creada = carpeta.mkdir();
			    if (!creada) {
			        System.out.println("Error: no se pudo crear la carpeta Reportes");
			        return;
			    }
			}

		    if (op == 1) {
		        generarReporteParalelo("C1");

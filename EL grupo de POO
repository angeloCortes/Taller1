	    try {
	        BufferedWriter reporte = new BufferedWriter(new FileWriter(nombreArchivo));

	        reporte.write("=== Miembros del grupo - Paralelo " + paralelo + " ===");
	        reporte.newLine();

	        for (int i = 0; i < totalAceptados; i++) {
	            if (paraleloAceptados[i].equalsIgnoreCase(paralelo)) {
	                reporte.write(nombreAceptados[i] + " " + apellidoAceptados[i] + " - " + rutAceptados[i]);
	                reporte.newLine();
	            }
	        }

	        reporte.close();
	        System.out.println("Reporte generado: " + nombreArchivo + "\n");

	    } catch (IOException e) {
	        System.out.println("Error al generar el reporte...");
	    }
		
	}
	
	/* Se creo la administación curso
	 * 
	 */
	private static void administracionCurso() {
		Scanner scanner = new Scanner(System.in);
		int op = 0;
	
		System.out.println("--- Administracion del curso ---");
		System.out.println("1) Cambiar paralelo de un alumno");
		System.out.println("2) Eliminar alumno del curso");
		System.out.println("3) Inscribir alumno nuevo");
		System.out.println("4) Volver");
		System.out.print("Ingrese opción: ");
		
		try {
			op = Integer.parseInt(scanner.nextLine());
		}catch (NumberFormatException e) {
			System.out.print("Error: debe ingresar una opción valida\n");
		}
		
		
		if (op == 1) {
			System.out.println("Ingrese RUT del alumno: ");
			String buscandoRut = scanner.nextLine();
			
			int indice = -1;
			for (int i = 0; i < totalAlumnos; i++) {
				if (rutAlumno[i].equals(buscandoRut)){
					indice = i;
					break;
					
				}
			
			}
			if (indice != -1) {
				System.out.println("Alumno: "+ nombreAlumno[indice] + " " + apellidoAlumno[indice] + " (actualmente en " + paraleloAlumno[indice] + ")");
				System.out.print("Nuevo paralelo (C1/C2): ");
				String nuevoParalelo = scanner.nextLine();
				
				if (nuevoParalelo.equalsIgnoreCase("C1") || nuevoParalelo.equalsIgnoreCase("C2")) {
					paraleloAlumno[indice] = nuevoParalelo.toUpperCase();
					modificarInformacion();
					System.out.println("Paralelo actualizado! Cambios guardados en Alumnos.txt\n");
					
				}else {
					System.out.println("Paralelo inválido");
				}
				
			} else {
				System.out.println("Alumno no encontrado");
			}
			
		} else if (op == 2) {
			System.out.println("Ingrese Rut del alumnos a eliminar: ");
			String eliminarRut = scanner.nextLine();
			
			int indice = -1;
			for (int i = 0; i < totalAlumnos; i++) {
				if (rutAlumno[i].equals(eliminarRut)){
					indice = i;
					break;
					
				}
			
			}
			if (indice != -1) {
				for (int i = indice; i < totalAlumnos - 1; i++) {
					nombreAlumno[i] = nombreAlumno[i + 1];
					apellidoAlumno[i] = apellidoAlumno[i + 1];
					rutAlumno[i] = rutAlumno[i +1];
					paraleloAlumno[i] = paraleloAlumno[i + 1];
					
				}
				totalAlumnos--;
				modificarInformacion();
				System.out.println("Alumno eliminado! Cambios guardados en Alumnos.txt");
			}else {
				System.out.println("Alumno no encontrado");
			}
			
		}else if (op == 3) {
			if (totalAlumnos < 100) {
				System.out.println("Ingrese nombre: ");
				String nombreNuevo = scanner.nextLine();
				System.out.println("Ingrese apellido: ");
				String apellidoNuevo = scanner.nextLine();
				System.out.println("Ingrese RUT: ");
				String rutNuevo = scanner.nextLine();
				System.out.println("Ingrese paralelo (C1/C2): ");
				String paraleloNuevo = scanner.nextLine();
				
				if (nombreNuevo.length() > 0 && apellidoNuevo.length() > 0 && rutNuevo.length() > 0 && (paraleloNuevo.equalsIgnoreCase("C1") || paraleloNuevo.equalsIgnoreCase("C2"))) {
					nombreAlumno[totalAlumnos] = nombreNuevo;
					apellidoAlumno[totalAlumnos] = apellidoNuevo;
					rutAlumno[totalAlumnos] = rutNuevo;
					paraleloAlumno[totalAlumnos] = paraleloNuevo.toUpperCase();
					totalAlumnos++;
					modificarInformacion();
					System.out.println("Alumnos agregado! Cambio guardados en Alumnos.txt\n");
				}else {
					System.out.println("No se encontro ningun dato válido");
					
				}
			}else {
				System.out.println("No se pudo agregar al alumno. Lista llena.");
			}
			
		}else if (op == 4) {
			System.out.println("Volviendo...");
			
		}else {
			System.out.println("Error: Ingrese una opción valida");
		}
	}
	
	
	private static void modificarInformacion() {
		try {
			BufferedWriter cambio = new BufferedWriter(new FileWriter("Alumnos.txt"));
			for (int i = 0; i < totalAlumnos; i++) {
				cambio.write(nombreAlumno[i] + ";" + apellidoAlumno[i] + ";" + rutAlumno[i] + ";" + paraleloAlumno[i]);
				cambio.newLine();
			}
			cambio.close();
		
		}catch(IOException e) {
			System.out.println("Error al guardar el archivo...");
		}
		
	}

	/*Se creo la función para inscribir manualmente*/
	private static void inscripcionManual() {

		Scanner scanner = new Scanner(System.in);

		int op = 0;

		System.out.println("\n¿Como se desea inscribir a la persona?: ");

		System.out.println("1) Por nombre completo");

		System.out.println("2) Por RUT");

		System.out.print("Ingrese opción: ");

		try {

			op = Integer.parseInt(scanner.nextLine());

		} catch (NumberFormatException e) {

			System.out.println("Error: debe ingresar una opción valida\n");

		}

		/*se hizo el proceso para inscribir por nombre completo*/
		if (op == 1) {

			System.out.print("Ingrese nombre completo (EJ: Martin-Droguett): ");

			String nombreCompleto = scanner.nextLine();

			String[] partes = nombreCompleto.split("-");

			if (partes.length == 2) {

				String nombre = partes[0].trim();

				String apellido = partes[1].trim();

				boolean encontrado = false;

				/*Recorre y guarda nombres validos*/
				for (int i = 0; i < totalAlumnos; i++) {

					if (nombreAlumno[i].equalsIgnoreCase(nombre) && apellidoAlumno[i].equalsIgnoreCase(apellido)) {
						encontrado = true;
						if (!yaFueAceptado(rutAlumno[i])) {
			                agregarAceptado(i);
			                    
							
							System.out.println("Se inscribio a " + nombre + " " + apellido + " exitosamente");
						
						}else {
							nombreRechazados[totalRechazados] = nombreSolicitud[i];

							apellidoRechazados[totalRechazados] = apellidoSolicitud[i];

							System.out.println("[Rechazado] " + nombreRechazados[totalRechazados] + " "
									+ apellidoRechazados[totalRechazados] + " --> Ya fue procesado");

							totalRechazados++;
							
						}
							
						break;
						
					}
		
				}
				/*Guarda en la lista los nombres invalidos*/
				if (!encontrado) {
					nombreRechazados[totalRechazados] = nombre;

					apellidoRechazados[totalRechazados] = apellido;

					System.out.println("El estudiante " + nombre + " "
							+ apellido + " no pertenece a ningun paralelo");

					totalRechazados++;

				}

			}else {
				System.out.println("Error: ingrese formato valido...");
			}

		/*se hizo el proceso para validar RUT de estudiantes*/
		}else if (op == 2) {
			System.out.println("Ingrese RUT del alumno que desea ingresar");
			String rutEstudiante = scanner.nextLine();
			boolean rutValido = false;

			/*Recorre y guarda RUT validos*/
			for (int i = 0; i < totalAlumnos; i++) {
				if (rutAlumno[i].equals(rutEstudiante)) {
					rutValido = true;
					if (!yaFueAceptado(rutAlumno[i])) {
	                    agregarAceptado(i);
	                    
	                }else {
						nombreRechazados[totalRechazados] = nombreSolicitud[i];

						apellidoRechazados[totalRechazados] = apellidoSolicitud[i];

						System.out.println("[Rechazado] " + nombreRechazados[totalRechazados] + " "
								+ apellidoRechazados[totalRechazados] + " --> Ya fue procesado");

						totalRechazados++;
						
					}
					
					break;
				}
				
			}
			/*guarda en una lista los RUT que no son validos*/
			if (!rutValido) {
				System.out.println("El RUT: " + rutEstudiante + " no pertenece a ningun paralelo.");
				System.out.println("No se tiene e nombre, por lo que se almacenara solo el RUT.\n");
				nombreRechazados[totalRechazados] = "NO EXISTE";
			    apellidoRechazados[totalRechazados] = "NO EXISTE";
				rutRechazados[totalRechazados] = rutEstudiante;

				totalRechazados++;
				
			}
			
		}else {
			System.out.println("Error: ingrese una opción valida...");
		}

	}

	/*
	 * aqui se procesan las solicitudes
	 * 
	 */

	private static void procesarSolicitudes() {

		System.out.println("\nProcesando solicitudes...");

		totalAceptados = 0;

		totalRechazados = 0;

		/*
		 * Cambia indice le la lista de solicitudes, booleano para la confirmacion de la
		 * lista de solicitudes
		 */

		for (int i = 0; i < totalSolicitudes; i++) {

			boolean encontrado = false;

			/* Cambia indice de la lista de alumnos */

			for (int j = 0; j < totalAlumnos; j++) {

				if (nombreSolicitud[i].equals(nombreAlumno[j]) && apellidoSolicitud[i].equals(apellidoAlumno[j])) {

					/* Confirma si la solicitud ya fue aceptada o no, en casos de que se repita */
					/* Agrega en la lista aceptados */

					if (!yaFueAceptado(rutAlumno[j])) {

						agregarAceptado(j);
						/* Procesa las solicitudes repetidas */

					}else {

						nombreRechazados[totalRechazados] = nombreSolicitud[i];

						apellidoRechazados[totalRechazados] = apellidoSolicitud[i];

						System.out.println("[Rechazado] " + nombreRechazados[totalRechazados] + " "
								+ apellidoRechazados[totalRechazados] + " --> Ya fue procesado");

						totalRechazados++;

					}

					encontrado = true;

					break;

				}

			}

			/* comprueba y agrega las solicitudes rechazadas */

			if (!encontrado) {

				nombreRechazados[totalRechazados] = nombreSolicitud[i];

				apellidoRechazados[totalRechazados] = apellidoSolicitud[i];

				System.out.println("[Rechazado] " + nombreRechazados[totalRechazados] + " "
						+ apellidoRechazados[totalRechazados] + " --> No pertenece a ningun paralelo");

				totalRechazados++;

			}

		}

		System.out.println("Resumen: " + totalAceptados + " aceptados / " + totalRechazados + " rechazados\n");

	}

	/**
	 * 
	 * Carga las solicitudes de ingreso desde el archivo {@code Solicitudes.txt}.
	 * 
	 */

	private static void cargarSolicitudes() throws FileNotFoundException {

		File listaSolicitudes = new File("Solicitudes.txt");

		Scanner linea = new Scanner(listaSolicitudes);

		int i = 0;

		while (linea.hasNextLine()) {

			String datosSolicitudes = linea.nextLine();

			String[] datos = datosSolicitudes.split("-");

			nombreSolicitud[i] = datos[0];

			apellidoSolicitud[i] = datos[1];

			i++;

		}

		System.out.println("Se cargaron " + i + " solicitudes... \n");

		totalSolicitudes = i;

		linea.close();

		return;

	}

	/**
	 * 
	 * Carga los datos de los alumnos desde el archivo {@code Alumnos.txt}.
	 * 
	 */

	private static void cargarAlumnos() throws FileNotFoundException {

		File listaAlumnos = new File("Alumnos.txt");

		Scanner linea = new Scanner(listaAlumnos);

		int i = 0;

		while (linea.hasNextLine()) {

			String datosAlumno = linea.nextLine();

			String[] datos = datosAlumno.split(";");

			nombreAlumno[i] = datos[0];

			apellidoAlumno[i] = datos[1];

			rutAlumno[i] = datos[2];

			paraleloAlumno[i] = datos[3];

			i++;

		}

		System.out.println("\nArchivos cargado exitosamente!");

		System.out.println("se cargaron " + i + " alumnos en la lista");

		totalAlumnos = i;

		linea.close();

		return;

	}
	/*cambios para acortar procesos repetidos*/
	
	/* Verifica si un RUT ya esta en la lista de aceptados (evita duplicados) */
	private static boolean yaFueAceptado(String rut) {
	    for (int k = 0; k < totalAceptados; k++) {
	        if (rutAceptados[k].equals(rut)) {
	            return true;
	        }
	    }
	    return false;
	}
	
	/* Agrega el alumno (segun su indice en los arreglos de alumnos) a la lista de aceptados */
	private static void agregarAceptado(int indice) {
	    nombreAceptados[totalAceptados] = nombreAlumno[indice];
	    apellidoAceptados[totalAceptados] = apellidoAlumno[indice];
	    rutAceptados[totalAceptados] = rutAlumno[indice];
	    paraleloAceptados[totalAceptados] = paraleloAlumno[indice];

	    if (paraleloAlumno[indice].equalsIgnoreCase("C1")) {
	        admitidosC1++;
	    } else if (paraleloAlumno[indice].equalsIgnoreCase("C2")) {
	        admitidosC2++;
	    }

	    System.out.println("[Aceptado] " + nombreAlumno[indice] + " " + apellidoAlumno[indice]
	            + " --> Admitido en " + paraleloAlumno[indice]);

	    totalAceptados++;
	}


		    	System.out.println("Volviendo...");
		        return;
		    } else {
		        System.out.println("Error: ingrese una opción valida...\n");
		    }
			
		}while (op != 4);
		
	}
	/*genera los reportes de rechazados*/
	private static void generarReporteRechazados() {
		int version = obtenerSiguienteVersion("Rechazados");
	    String nombreArchivo = "Reportes/Rechazados-V" + version + ".txt";

	    try {
	        BufferedWriter reporte = new BufferedWriter(new FileWriter(nombreArchivo));

	        reporte.write("=== Solicitudes rechazadas ===");
	        reporte.newLine();

	        for (int i = 0; i < totalRechazados; i++) {

	            if (nombreRechazados[i].equals("NO EXISTE")) {
	                reporte.write("Sin nombre registrado, RUT: " + rutRechazados[i]);
	            } else {
	                reporte.write(nombreRechazados[i] + " " + apellidoRechazados[i]
	                        + " - No pertenece a ningun paralelo del curso");
	            }

	            reporte.newLine();
	        }

	        reporte.close();
	        System.out.println("Reporte generado: " + nombreArchivo + "\n");

	    } catch (IOException e) {
	        System.out.println("Error al generar el reporte...");
	    }
		
	}
	/*genera los reportes de los paralelos*/
	private static void generarReporteParalelo(String paralelo) {

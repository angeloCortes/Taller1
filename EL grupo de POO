	private static void estadisticasTotales() {
		System.out.println("--- Analisis estadistico ---");
		intentosIngreso = totalAceptados + totalRechazados;
		System.out.println("Total de intentos de ingreso:" + intentosIngreso);
		
		double porcentajeRechazados = 0.0;
		
		if (intentosIngreso > 0) {
			porcentajeRechazados = ((double)totalRechazados / intentosIngreso) * 100;
		}
		
		/* String.format("%.1f" para redondear el porcentaje
		 * 
		 */
		System.out.println("Rechazados: "+ totalRechazados + " (" +  String.format("%.1f", porcentajeRechazados) + "%)");
		System.out.println("Admitidos por paralelo -> C1: " + admitidosC1 + " | C2: " + admitidosC2);
		double porcentajeC1 = 0.0;
		double porcentajeC2 = 0.0;
		
		int sumaParalelos = 0;
		
		sumaParalelos = admitidosC1 + admitidosC2;
		if (admitidosC1 > 0) {
			porcentajeC1 = ((double)admitidosC1 / sumaParalelos) * 100;
		}
		if (admitidosC2 > 0) {
			porcentajeC2 = ((double)admitidosC2 / sumaParalelos) * 100;
		}
		
		/* String.format("%.1f" para redondear el porcentaje
		 * 
		 */
		System.out.println("Porcentaje de alumnos por paralelo -> C1: " + admitidosC1 + "  Alumnos (" + String.format("%.1f",porcentajeC1) + "%) | C2: " + admitidosC2 + " Alumnos (" + String.format("%.1f",porcentajeC2) + "%)");
		
		if (admitidosC1 > admitidosC2) {
			System.out.println("El paralelo con más alumnos es el C1 con: " + admitidosC1 + " Alumnos");
		}else if (admitidosC1 < admitidosC2) {
			System.out.println("El paralelo con más alumnos es el C2 con: " + admitidosC2 + " Alumnos");
		} else {
			System.out.println("Ambos paralelos tienen la misma cantidad de alumnos: " + admitidosC2 + " Alumnos");
		}
		
		
		double tasaAdmision = 0.0;
		
		if (intentosIngreso > 0) {
			tasaAdmision = ((double)totalAceptados / intentosIngreso) * 100;
			
		}
		System.out.println("Tasa de admision: " + String.format("%.1f", tasaAdmision) + "%\n");
	}
	
	
	
	
	/*verifica la versión del archivo*/
	private static int obtenerSiguienteVersion(String nomArchivo) {
	    int version = 1;
	    // arma el nombre que tendria la version 1 (ej: "Reportes/ReporteC1-V1.txt")
	    File archivo = new File("Reportes/" + nomArchivo + "-V" + version + ".txt");

	    while (archivo.exists()) {
	        version++;
	        archivo = new File("Reportes/" + nomArchivo + "-V" + version + ".txt");
	    }

	    return version;
	}
	
	/*creación de reportes*/
	private static void generarReportes() {
		Scanner scanner = new Scanner(System.in);
		int op = 0;
		
		do {
			System.out.println("\n--- Generar reportes ---");
			System.out.println("1) Reporte paralelo C1");
			System.out.println("2) Reporte paralelo C2");
			System.out.println("3) Reporte de rechazados");
			System.out.println("4) Volver");
			System.out.print("Ingrese opción: ");
			
